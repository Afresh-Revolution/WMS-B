generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  suspended
  locked
  terminated
  pending
}

enum AccountType {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ApprovalStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

model User {
  id                       String          @id @default(uuid()) @db.Uuid
  employeeId               String?         @unique @map("employee_id") @db.Uuid
  fullName                 String?         @map("full_name")
  email                    String          @unique
  username                 String?         @unique
  phone                    String?
  passwordHash             String          @map("password_hash")
  profilePhoto             String?         @map("profile_photo")
  roleId                   String?         @map("role_id") @db.Uuid
  departmentId             String?         @map("department_id") @db.Uuid
  accountType              AccountType     @default(STAFF) @map("account_type")
  status                   UserStatus      @default(active)
  permissions              Json            @default("[]")
  emailVerified            Boolean         @default(false) @map("email_verified")
  phoneVerified            Boolean         @default(false) @map("phone_verified")
  mustChangePassword       Boolean         @default(false) @map("must_change_password")
  failedLoginAttempts      Int             @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?       @map("locked_until")
  lastLoginAt              DateTime?       @map("last_login_at")
  lastLoginIp              String?         @map("last_login_ip") @db.Inet
  lastActivityAt           DateTime?       @map("last_activity_at")
  passwordChangedAt        DateTime?       @map("password_changed_at")
  emailVerifiedAt          DateTime?       @map("email_verified_at")
  createdBy                String?         @map("created_by") @db.Uuid
  updatedBy                String?         @map("updated_by") @db.Uuid
  deactivatedAt            DateTime?       @map("deactivated_at")
  deactivatedBy            String?         @map("deactivated_by") @db.Uuid
  activationTokenHash      String?         @map("activation_token_hash")
  activationTokenExpiresAt DateTime?       @map("activation_token_expires_at")
  deletedAt                DateTime?       @map("deleted_at")
  deletedBy                String?         @map("deleted_by") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  employee                 Employee?       @relation(fields: [employeeId], references: [id])
  role                     Role?           @relation(fields: [roleId], references: [id])
  department               Department?     @relation(fields: [departmentId], references: [id])
  userRoles                UserRole[]
  sessions                 UserSession[]
  loginHistory             LoginHistory[]
  failedLogins             FailedLogin[]
  notifications            Notification[]
  auditLogs                AuditLog[]      @relation("ActorAuditLogs")

  @@index([roleId, status])
  @@index([departmentId])
  @@index([accountType, status])
  @@map("users")
}

model Role {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique
  name         String
  description  String?
  isSystemRole Boolean          @default(false) @map("is_system_role")
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  users        User[]
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String?
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  status           String    @default("active")
  device           String?
  browser          String?
  operatingSystem  String?   @map("operating_system")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  location         String?
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  status    String
  reason    String?
  device    String?
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("login_history")
}

model FailedLogin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?
  userId    String?  @map("user_id") @db.Uuid
  reason    String?
  device    String?
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@map("failed_logins")
}

model SecuritySetting {
  id                         String    @id @default(uuid()) @db.Uuid
  minimumPasswordLength      Int       @default(10) @map("minimum_password_length")
  requireUppercase           Boolean   @default(true) @map("require_uppercase")
  requireLowercase           Boolean   @default(true) @map("require_lowercase")
  requireNumber              Boolean   @default(true) @map("require_number")
  requireSymbol              Boolean   @default(true) @map("require_symbol")
  passwordExpiryEnabled      Boolean   @default(false) @map("password_expiry_enabled")
  passwordExpiryDays         Int       @default(90) @map("password_expiry_days")
  passwordHistoryEnabled     Boolean   @default(true) @map("password_history_enabled")
  passwordHistoryCount       Int       @default(5) @map("password_history_count")
  requireMfa                 Boolean   @default(false) @map("require_mfa")
  allowEmailMfa              Boolean   @default(true) @map("allow_email_mfa")
  allowAuthenticatorMfa      Boolean   @default(true) @map("allow_authenticator_mfa")
  maxLoginAttempts           Int       @default(5) @map("max_login_attempts")
  lockoutDurationMinutes     Int       @default(30) @map("lockout_duration_minutes")
  sessionTimeoutMinutes      Int       @default(60) @map("session_timeout_minutes")
  maxConcurrentSessions      Int       @default(5) @map("max_concurrent_sessions")
  allowRememberDevice        Boolean   @default(true) @map("allow_remember_device")
  maintenanceMode            Boolean   @default(false) @map("maintenance_mode")
  maintenanceMessage         String?   @map("maintenance_message")
  active                     Boolean   @default(true)
  updatedBy                  String?   @map("updated_by") @db.Uuid
  deletedAt                  DateTime? @map("deleted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("security_settings")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("password_history")
}

model UserMfa {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  method          String
  secretEncrypted String?   @map("secret_encrypted")
  enabled         Boolean   @default(false)
  verified        Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastUsedAt      DateTime? @map("last_used_at")

  @@unique([userId, method])
  @@map("user_mfa")
}

model MfaChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  method         String
  otpHash        String    @map("otp_hash")
  status         String    @default("pending")
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("mfa_challenges")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String?
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent")
  successful    Boolean  @default(false)
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model TrustedDevice {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  deviceIdentifierHash String    @map("device_identifier_hash")
  deviceName           String?   @map("device_name")
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  lastUsedAt           DateTime? @map("last_used_at")

  @@index([userId, revokedAt])
  @@map("trusted_devices")
}

model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  outcome     String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("security_events")
}

model Employer {
  id                 String       @id @default(uuid()) @db.Uuid
  companyName        String       @map("company_name")
  registrationNumber String?      @map("registration_number")
  taxInformation     Json         @default("{}") @map("tax_information")
  companyEmail       String?      @map("company_email")
  phone              String?
  website            String?
  logoFileId         String?      @map("logo_file_id") @db.Uuid
  address            String?
  workingHours       Json         @default("{}") @map("working_hours")
  currency           String?
  timezone           String?
  companyPolicies    Json         @default("{}") @map("company_policies")
  deletedAt          DateTime?    @map("deleted_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  branches           Branch[]

  @@map("employers")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  employerId String?      @map("employer_id") @db.Uuid
  name       String
  address    String?
  location   String?
  status     String       @default("active")
  deletedAt  DateTime?    @map("deleted_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  employer   Employer?    @relation(fields: [employerId], references: [id])
  departments Department[]

  @@map("branches")
}

model Department {
  id             String      @id @default(uuid()) @db.Uuid
  branchId       String?     @map("branch_id") @db.Uuid
  name           String
  code           String      @unique
  description    String?
  hodId          String?     @map("hod_id") @db.Uuid
  assistantHodId String?     @map("assistant_hod_id") @db.Uuid
  location       String?
  email          String?
  phone          String?
  budget         Decimal?    @db.Decimal(14, 2)
  status         String      @default("active")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  branch         Branch?     @relation(fields: [branchId], references: [id])
  users          User[]
  employees      Employee[]
  interns        Intern[]
  nyscMembers    NyscMember[]
  positions      Position[]
  tasks          Task[]
  targets        Target[]
  expenses       Expense[]
  purchases      PurchaseRequest[]

  @@index([status, hodId])
  @@map("departments")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  title        String
  level        String?
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@map("positions")
}

model Employee {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  employeeNumber   String       @unique @map("employee_number")
  firstName        String?      @map("first_name")
  lastName         String?      @map("last_name")
  fullName         String?      @map("full_name")
  email            String?
  phone            String?
  dateOfBirth      DateTime?    @map("date_of_birth")
  gender           String?
  address          String?
  employmentDate   DateTime?    @map("employment_date")
  employmentType   String?      @map("employment_type")
  jobTitle         String?      @map("job_title")
  departmentId     String?      @map("department_id") @db.Uuid
  positionId       String?      @map("position_id") @db.Uuid
  supervisorId     String?      @map("supervisor_id") @db.Uuid
  salary           Decimal?     @db.Decimal(14, 2)
  status           String       @default("active")
  emergencyContact Json         @default("{}") @map("emergency_contact")
  bankInformation  Json         @default("{}") @map("bank_information")
  taxInformation   Json         @default("{}") @map("tax_information")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user             User?
  department       Department?  @relation(fields: [departmentId], references: [id])
  position         Position?    @relation(fields: [positionId], references: [id])
  leaveRequests    LeaveRequest[]
  expenses         Expense[]
  payrollItems     PayrollItem[]
  disciplinaryCases DisciplinaryCase[]

  @@index([departmentId, status])
  @@index([email])
  @@map("employees")
}

model LeaveType {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  daysAllowed      Int?           @map("days_allowed")
  requiresApproval Boolean        @default(true) @map("requires_approval")
  status           String         @default("active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  requests         LeaveRequest[]
  balances         LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  allocatedDays  Decimal   @default(0) @map("allocated_days") @db.Decimal(8, 2)
  usedDays       Decimal   @default(0) @map("used_days") @db.Decimal(8, 2)
  remainingDays  Decimal   @default(0) @map("remaining_days") @db.Decimal(8, 2)
  year           Int
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String         @id @default(uuid()) @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  leaveTypeId     String         @map("leave_type_id") @db.Uuid
  startDate       DateTime       @map("start_date")
  endDate         DateTime       @map("end_date")
  numberOfDays    Decimal        @map("number_of_days") @db.Decimal(8, 2)
  reason          String?
  status          ApprovalStatus @default(pending)
  submittedAt     DateTime       @default(now()) @map("submitted_at")
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at")
  rejectionReason String?        @map("rejection_reason")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  employee        Employee       @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType      @relation(fields: [leaveTypeId], references: [id])

  @@index([status, submittedAt])
  @@map("leave_requests")
}

model Task {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  assignedTo   String?     @map("assigned_to") @db.Uuid
  createdBy    String?     @map("created_by") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  priority     String?
  dueDate      DateTime?   @map("due_date")
  status       String      @default("todo")
  completedAt  DateTime?   @map("completed_at")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([status, dueDate])
  @@map("tasks")
}

model Target {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  employeeId   String?     @map("employee_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  targetType   String      @map("target_type")
  targetValue  Decimal     @default(0) @map("target_value") @db.Decimal(14, 2)
  currentValue Decimal     @default(0) @map("current_value") @db.Decimal(14, 2)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  status       String      @default("active")
  createdBy    String?     @map("created_by") @db.Uuid
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId, status])
  @@map("targets")
}

model PayrollRun {
  id          String        @id @default(uuid()) @db.Uuid
  period      String
  status      String        @default("draft")
  approvedBy  String?       @map("approved_by") @db.Uuid
  processedAt DateTime?     @map("processed_at")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  items       PayrollItem[]

  @@map("payroll")
}

model PayrollItem {
  id          String     @id @default(uuid()) @db.Uuid
  payrollId   String     @map("payroll_id") @db.Uuid
  employeeId  String     @map("employee_id") @db.Uuid
  basicSalary Decimal    @default(0) @map("basic_salary") @db.Decimal(14, 2)
  allowances  Decimal    @default(0) @db.Decimal(14, 2)
  bonuses     Decimal    @default(0) @db.Decimal(14, 2)
  deductions  Decimal    @default(0) @db.Decimal(14, 2)
  tax         Decimal    @default(0) @db.Decimal(14, 2)
  pension     Decimal    @default(0) @db.Decimal(14, 2)
  overtime    Decimal    @default(0) @db.Decimal(14, 2)
  loans       Decimal    @default(0) @db.Decimal(14, 2)
  netSalary   Decimal    @default(0) @map("net_salary") @db.Decimal(14, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  payroll     PayrollRun @relation(fields: [payrollId], references: [id])
  employee    Employee   @relation(fields: [employeeId], references: [id])

  @@map("payroll_items")
}

model PurchaseRequest {
  id              String      @id @default(uuid()) @db.Uuid
  reference       String?     @unique
  requesterId     String?     @map("requester_id") @db.Uuid
  departmentId    String?     @map("department_id") @db.Uuid
  itemDescription String?     @map("item_description")
  quantity        Decimal?    @db.Decimal(14, 2)
  estimatedAmount Decimal?    @map("estimated_amount") @db.Decimal(14, 2)
  reason          String?
  status          String      @default("draft")
  approvedBy      String?     @map("approved_by") @db.Uuid
  approvedAt      DateTime?   @map("approved_at")
  rejectedBy      String?     @map("rejected_by") @db.Uuid
  rejectionReason String?     @map("rejection_reason")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  department      Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId, status])
  @@map("purchase_requests")
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String?
  email       String?
  phone       String?
  address     String?
  taxId       String?  @map("tax_id")
  bankDetails Json     @default("{}") @map("bank_details")
  status      String   @default("active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bills       Bill[]

  @@map("vendors")
}

model Bill {
  id               String    @id @default(uuid()) @db.Uuid
  vendorId         String?   @map("vendor_id") @db.Uuid
  invoiceNumber    String    @map("invoice_number")
  amount           Decimal   @db.Decimal(14, 2)
  dueDate          DateTime? @map("due_date")
  category         String?
  status           String    @default("pending")
  uploadedDocument String?   @map("uploaded_document")
  approvedBy       String?   @map("approved_by") @db.Uuid
  paidAt           DateTime? @map("paid_at")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vendor           Vendor?   @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, invoiceNumber])
  @@map("bills")
}

model Expense {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String?     @map("employee_id") @db.Uuid
  departmentId    String?     @map("department_id") @db.Uuid
  description     String?
  amount          Decimal     @db.Decimal(14, 2)
  date            DateTime?
  category        String?
  notes           String?
  receiptUrl      String?     @map("receipt_url")
  status          String      @default("submitted")
  reviewedBy      String?     @map("reviewed_by") @db.Uuid
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason")
